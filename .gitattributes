# Keep source files readable and line endings deterministic in repository archives.
* text=auto eol=lf

# Preserve serialized and checksum-addressed artifacts byte for byte.
*.joblib binary
*.xlsx binary
*.bat -text
model_bundle.js -text
held_out_test_data.js -text
models/model_bundle.json -text
models/*.json -text
validation/*.csv -text
validation/*.json -text
examples/*.csv -text
data/*.csv text eol=lf
data/data_release_checks.json -text -eol
artifacts/cv/*.csv text eol=lf
checksums.sha256 -text
release_manifest.json -text
RELEASE_CHECKS.json -text
